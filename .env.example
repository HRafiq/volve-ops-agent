# Placeholders only. Never put a real key in this file.
# Copy to .env, which is git-ignored, and fill in locally.

# Databricks workspace holding the Volve share. The host is the URL in your browser
# address bar when signed in, with no trailing path.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Where the Marketplace share landed. Not a secret; it just has to match your catalog.
VOLVE_VOLUME_PATH=/Volumes/equinor_asa_volve_data_village/public/volve
VOLVE_ZIP_VOLUME_PATH=/Volumes/equinor_asa_volve_data_village/public/volvezipfiles

# Model provider credentials
OPENAI_API_KEY=

# MLflow tracking, if not using the local default store
MLFLOW_TRACKING_URI=

# Hard spending cap for any public demo deployment, in USD
DEMO_MODEL_BUDGET_USD=
